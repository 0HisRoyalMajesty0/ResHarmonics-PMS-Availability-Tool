# Copy this file to .env (and make sure .env is in .gitignore — never commit it)
# Values come from the "Gravity Coliving v3 API" doc.

RESHARMONICS_CLIENT_ID=
RESHARMONICS_CLIENT_SECRET=

# Optional — only needed by departing_tenants_cleaning.py, to read cleaning
# preferences from the CRM. Without it that script still produces the departure
# list; the Pipedrive half can be done via the Pipedrive MCP tools instead.
PIPEDRIVE_API_TOKEN=

# Optional — set once the tenancy/departures endpoint is confirmed live, so the
# script stops resolving it from the OpenAPI spec on every run.
# RESHARMONICS_DEPARTURES_ENDPOINT=

# Optional — only override if these change:
# RESHARMONICS_API_BASE=https://apiv3.rerumapp.uk
# RESHARMONICS_AUTH_URL=https://auth.rerumapp.uk/oauth2/token
